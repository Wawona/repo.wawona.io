+/// wwn-iland: Mode B hooks libc open("/dev/dri/..."), not rustix stat(2).
+#[cfg(target_os = "macos")]
+fn drm_node_open_iland(path: &Path) -> anyhow::Result<DrmNode> {
+    use std::fs::OpenOptions;
+
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(path)
+        .with_context(|| format!("error opening DRM path {path:?}"))?;
+    DrmNode::from_file(&file).with_context(|| format!("error parsing DRM node {path:?}"))
+}
