@@ -168,7 +168,18 @@ fn egl_has_wayland_winsys() -> bool {
             .any(|ext| ext == "EGL_KHR_platform_wayland" || ext == "EGL_EXT_platform_wayland")
     }
 }
 
+/// Pixman nested weston (iOS Machines Start) has wl_shm only. Iland EGL still
+/// reports Wayland-EGL, so probing the library would attach dmabuf/IOSurface
+/// that weston never maps: `niri` from zsh claims start and shows no window.
+/// Use EGL present only when the host offers linux-dmabuf (Wawona itself).
+fn host_offers_linux_dmabuf(globals: &GlobalList) -> bool {
+    globals.contents().with_list(|list| {
+        list.iter()
+            .any(|g| g.interface == "zwp_linux_dmabuf_v1")
+    })
+}
+
 /// EGL native surface over a wl_egl_window for the host surface.
 struct NestedEglSurface(wegl::WlEglSurface);
 
